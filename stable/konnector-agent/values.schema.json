{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "required": [
    "agent",
    "pc",
    "k8sClusterName",
    "k8sDistribution",
    "categoryMappings"
  ],
  "properties": {
    "agent": {
      "type": "object",
      "required": [
        "namespaceOverride",
        "name",
        "port",
        "image",
        "updateConfigInMin",
        "updateMetricsInMin"
      ],
      "properties": {
        "namespaceOverride": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "pullPolicy",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "privateRegistry": {
              "type": "boolean"
            },
            "imageCredentials": {
              "type": "object",
              "properties": {
                "dockerconfig": {
                  "type": "string"
                }
              }
            }
          }
        },
        "updateConfigInMin": {
          "type": "integer"
        },
        "updateMetricsInMin": {
          "type": "integer"
        },
        "config": {
          "type": "object"
        }
      }
    },
    "pc": {
      "type": "object",
      "required": [
        "port",
        "insecure",
        "endpoint"
      ],
      "properties": {
        "port": {
          "type": "integer"
        },
        "insecure": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "apiKey": {
          "type": "string"
        },
        "additionalTrustBundle": {
          "type": "string"
        }
      }
    },
    "additionalTrustBundleConfigMapName": {
      "type": "string"
    },
    "k8sClusterName": {
      "type": "string"
    },
    "k8sDistribution": {
      "type": "string",
      "pattern": "^(CAPX|OCP|NKE|EKSA|NKP)$"
    },
    "categoryMappings": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "projectName": {
      "type": "string"
    },
    "prismCredentialsSecretName": {
      "type": "string"
    },
    "kubeconfigUpload": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "controlPlaneEndpoint": {
          "type": "string"
        },
        "flowConfigMapName": {
          "type": "string"
        },
        "flowLabelSelector": {
          "type": "string"
        },
        "clusterRoleKey": {
          "type": "string"
        },
        "serviceAccountName": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pc": {
            "properties": {
              "insecure": {
                "const": false
              }
            },
            "required": [
              "insecure"
            ]
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "additionalTrustBundleConfigMapName": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "additionalTrustBundleConfigMapName"
            ]
          },
          {
            "properties": {
              "pc": {
                "required": [
                  "additionalTrustBundle"
                ],
                "properties": {
                  "additionalTrustBundle": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "required": [
              "pc"
            ]
          }
        ]
      }
    }
    ,
    {
      "if": {
        "properties": {
          "prismCredentialsSecretName": {
            "maxLength": 0
          }
        }
      },
      "then": {
        "properties": {
          "pc": {
            "$comment": "When the chart creates the credentials Secret (prismCredentialsSecretName empty), validate the credential combination.",
            "allOf": [
              {
                "$comment": "An API key must not be combined with basic-auth credentials.",
                "if": {
                  "required": [
                    "apiKey"
                  ],
                  "properties": {
                    "apiKey": {
                      "minLength": 1
                    }
                  }
                },
                "then": {
                  "properties": {
                    "username": {
                      "maxLength": 0
                    },
                    "password": {
                      "maxLength": 0
                    }
                  }
                }
              },
              {
                "$comment": "Basic auth requires a password when a username is set.",
                "if": {
                  "required": [
                    "username"
                  ],
                  "properties": {
                    "username": {
                      "minLength": 1
                    }
                  }
                },
                "then": {
                  "required": [
                    "password"
                  ],
                  "properties": {
                    "password": {
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "$comment": "Basic auth requires a username when a password is set.",
                "if": {
                  "required": [
                    "password"
                  ],
                  "properties": {
                    "password": {
                      "minLength": 1
                    }
                  }
                },
                "then": {
                  "required": [
                    "username"
                  ],
                  "properties": {
                    "username": {
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
